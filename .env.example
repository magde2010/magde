# ══════════════════════════════════════════════════════════════
#  Mohamed Rade — MEXC Spot Portfolio Bot | متغيرات البيئة
#  انسخ هذا الملف إلى .env واملأ القيم الإلزامية
#  cp .env.example .env
#  ملاحظة: كل متغير مذكور هنا يُقرأ فعليًا في الكود.
# ══════════════════════════════════════════════════════════════

# ── إلزامي / Required ─────────────────────────────────────────

# توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=

# مفاتيح MEXC بصلاحيات Spot فقط (عطّل صلاحية السحب)
MEXC_API_KEY=
MEXC_API_SECRET=

# رابط قاعدة البيانات: postgresql://... (Railway) أو sqlite:///bot.db محليًا فقط
DATABASE_URL=

# معرّف تيليجرام الموجب لصاحب البوت — أي رقم آخر أو رقم غير صالح يمنع الإقلاع
# احصل عليه من @userinfobot وليس من اسم المستخدم
ADMIN_TELEGRAM_ID=

# ── اختياري / Optional ────────────────────────────────────────

# فترة مراقب وقف الخسارة بالثواني (الحد الأدنى 5، الافتراضي 15)
STOP_MONITOR_INTERVAL_SECONDS=15

# أدنى قيمة سوقية بالدولار تُعتبر حيازة حقيقية أثناء فحص العملات الناقصة
BALANCE_PRESENCE_MIN_USDT=1.0

# إصلاح اتجاه النص العربي RTL تلقائيًا (1 = مفعّل، 0 = معطّل)
UI_BIDI_FIX=1

# ملاحظة: حد أمر المحفظة الأدنى ثابت عند 2 USDT داخل config.py ولا يُضبط عبر البيئة.
# ملاحظة: فترة التهدئة لإعادة الدخول (90 ثانية) وتسامح مطابقة أوامر DCA ثوابت في
# rebalancer.py و portfolio_strategy.py، وليست متغيرات بيئة.
