# ══════════════════════════════════════════════════════════════
#  Mohamed Rade — MEXC Spot Portfolio Bot | متغيرات البيئة
#  انسخ هذا الملف إلى .env واملأ القيم الإلزامية
#  cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── إلزامي / Required ─────────────────────────────────────────

# توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=

# مفاتيح MEXC بصلاحيات Spot فقط (عطّل صلاحية السحب)
MEXC_API_KEY=
MEXC_API_SECRET=

# رابط قاعدة البيانات: postgres://... (Railway) أو sqlite:///bot.db محليًا
DATABASE_URL=

# معرّف تيليجرام الموجب لصاحب البوت — أي رقم آخر أو رقم غير صالح يمنع الإقلاع
ADMIN_TELEGRAM_ID=

# ── اختياري / Optional ────────────────────────────────────────

# فترة مراقب وقف الخسارة بالثواني (الحد الأدنى 5)
STOP_MONITOR_INTERVAL_SECONDS=15

# أدنى قيمة سوقية بالدولار تُعتبر حيازة حقيقية أثناء فحص العملات الناقصة
BALANCE_PRESENCE_MIN_USDT=1.0

# فترة التهدئة بين إجراءات المحفظة بالثواني
BTC_PORTFOLIO_ACTION_COOLDOWN_SEC=1800

# تسامحات فحص ملكية العملة بين المحافظ
OWNERSHIP_TOLERANCE_PCT=1.5
OWNERSHIP_TOLERANCE_AMOUNT=0.02
OWNERSHIP_TOLERANCE_USDT=1.0

# ملاحظة: حد أمر المحفظة الأدنى ثابت عند 2 USDT داخل config.py
