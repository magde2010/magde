# === مطلوب ===
MEXC_API_KEY=
MEXC_API_SECRET=
COINLOBSTER_API_KEY=
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# === اختياري ===
DATABASE_URL=sqlite:///smart_whale.db
# لو عايز تستخدم نفس Postgres بتاع البوت القديم حط الرابط هنا

# === إعدادات النظام ===
# رأس المال المخصص للنظام الذكي (بالدولار)
ALLOCATED_CAPITAL=150

# حجم الصفقة الواحدة (بالدولار)
POSITION_SIZE_USDT=30

# أقصى عدد صفقات مفتوحة في نفس الوقت
MAX_OPEN_POSITIONS=5

# مضاعف الحيتان المطلوب للدخول (مثلاً 2.5 يعني 2.5 ضعف النشاط الطبيعي)
MIN_MULTIPLE=1.5
FLOW_MIN_SCORE=82
FLOW_CONFIRMATIONS=2

# نافذة الرادار (1h أو 4h أو 24h)
RADAR_WINDOW=4h

# وقف الخسارة بالنسبة المئوية (مثلاً 7 = -7%)
STOP_LOSS_PCT=7.0

# جني أرباح جزئي (نسبة)
TAKE_PROFIT_1_PCT=8.0
TAKE_PROFIT_2_PCT=15.0

# كم مرة نفحص السوق (بالدقائق)
CHECK_INTERVAL_MINUTES=10
FLOW_RADAR_WINDOW=1h
FLOW_MIN_SCORE_BUY=82
FLOW_CONFIRMATION_MINUTES=15
FLOW_ENABLE_MEXC_MARKET_DATA=true

# العملات المسموح التداول عليها (مفصولة بفاصلة)
WATCHLIST=BTC,ETH,SOL,ADA,XRP,AVAX,SUI,NEAR,INJ,TAO,LINK,APT,ARB,SEI,AAVE,WLD,RENDER,FET,TIA,STX,UNI,ENA,XLM,GRT,CRO,ONDO
